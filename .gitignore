# Root monorepo ignore rules

# dependencies
**/node_modules/

# env files
**/.env
**/.env.*
!**/.env.example

# builds / caches
**/build/
**/dist/
**/.expo/
**/.turbo/
**/.cache/
**/coverage/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store

# Documentation
docs/

# Mobile application (separate repo)
FormCrafter/
